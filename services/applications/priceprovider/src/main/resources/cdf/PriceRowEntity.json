    "io.commercestacksolutions.commons.dataaccess.meta.MandatoryField",
    "io.commercestacksolutions.corebusinessentities.dataaccess.channel.entity.ChannelEntity",
    "io.commercestacksolutions.corebusinessentities.dataaccess.currency.entity.CurrencyEntity",
